{
  "name": "personal-line-harness-manager",
  "main": "src/worker.ts",
  "compatibility_date": "2026-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSIONS",
        "class_name": "ManagedOpenChat"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ManagedOpenChat"
      ]
    }
  ],
  "vars": {
    "PUBLIC_BASE_URL": "https://REPLACE-WITH-MANAGER-ORIGIN.example"
  }
}
