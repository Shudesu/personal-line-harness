{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "@cloudflare/workers-types",
      "node"
    ]
  },
  "include": [
    "apps/*/src/**/*.ts",
    "packages/mcp-server/src/**/*.ts",
    "test/**/*.ts"
  ]
}
